# Сайт с вкладкой «3Д»: слой поверх запущенного образа сайта — файлы раздела и общие файлы из живой основной
# папки с правками patch-live.mjs (что и почему — в prepare.sh). Контекст сборки готовит prepare.sh (папка build/).
# Тесты «3Д» (публикация и ссылки страницы публикаций — против живого кода этого образа) и сборка Next с
# проверкой типов: при любой ошибке образ не собирается, выкатывать нечего.
ARG BASE
FROM ${BASE}
COPY overlay/ /app/
RUN npx tsx --test tests/studio3d*.test.ts && npm run build
