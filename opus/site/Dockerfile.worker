# Воркер с монтажом «Опус 5.5»: слой поверх ЗАПУЩЕННОГО образа (воркер идёт на tsx, сборка не нужна). Проверка —
# импорт конвейера: опечатка в правке роняет сборку, а не первый монтаж.
ARG BASE
FROM ${BASE}
COPY overlay/ /app/
RUN npx tsx -e 'import("./lib/pipeline.ts").then(() => console.log("конвейер грузится"))'
